# Salin file ini jadi .env dan isi nilainya
# Railway: set variabel ini di Settings → Variables

# Path database SQLite (cache fundamental, riwayat sinyal, forum, dst).
# SENGAJA DIKOSONGKAN di sini -- default kode (ranah_saham.db) adalah file
# produksi yang sudah berisi data sungguhan. Isi baris ini HANYA kalau
# benar2 sengaja pindah ke file DB lain (mis. Railway: /data/ranah_saham.db
# dgn Volume di-mount ke /data supaya data tidak hilang tiap redeploy).
DATABASE_URL=

# Redis untuk cache TTL (analisis & harga real-time) dan rate limit per-IP.
# Tanpa ini aplikasi tetap jalan (fail-open ke "tanpa cache/rate-limit"),
# jadi hanya wajib diisi kalau menjalankan >1 instance/worker.
REDIS_URL=redis://localhost:6379/0

# Interval (detik) siklus auto-audit sinyal berjalan di background selama
# aplikasi hidup (refresh Top Pick + audit sinyal OPEN). Default 600 = 10
# menit.
SIGNAL_AUTO_INTERVAL_SECONDS=600

# Kode rahasia admin Forum (badge "Admin" + hak hapus thread/balasan).
# Kosong = fitur admin forum nonaktif sepenuhnya (fail-closed), forum tetap
# jalan normal tanpa admin. Pilih string acak yang panjang -- proteksi
# brute-force di sini mengandalkan rate limit, bukan kerumitan kode.
FORUM_ADMIN_SECRET=

# Admin pertama untuk akses akun gratis. Saat aplikasi boot, akun dengan email
# ini dibuat otomatis dan bisa menyetujui pendaftaran pengguna lain. Gunakan
# password unik minimal 10 karakter; JANGAN commit file .env yang sudah diisi.
ACCESS_ADMIN_EMAIL=admin@contoh.com
ACCESS_ADMIN_PASSWORD=ganti-dengan-password-unik-panjang

# Produksi HTTPS: biarkan 1. Untuk localhost HTTP saja gunakan 0 agar cookie
# sesi dapat tersimpan di browser lokal.
ACCESS_COOKIE_SECURE=1

# Login dengan Google (opsional). Buat OAuth Client jenis "Web application"
# di Google Cloud Console lalu daftarkan redirect URI PERSIS seperti di bawah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ranahsaham.com/api/access/google/callback

# Broadcast sinyal ke grup WhatsApp (lihat wa-bot/README.md untuk setup).
# Kosong = fitur nonaktif diam-diam, tidak ada error ke user.
# WA_BOT_URL: docker-compose sudah set otomatis (http://wa-bot:3901); isi
# manual hanya kalau jalankan wa-bot di luar docker-compose.
WA_BOT_URL=
# String acak panjang, HARUS SAMA dgn WA_BOT_SECRET di service wa-bot.
WA_BOT_SECRET=
# JID grup WhatsApp target (format xxxxx@g.us) -- lihat wa-bot/README.md
# langkah "Setup awal" untuk cara menemukannya. Diset di service wa-bot,
# BUKAN di sini (baris ini cuma dokumentasi; nilai sebenarnya ada di env
# service wa-bot pada docker-compose.yml).
WA_GROUP_JID=
# Jam kirim digest harian, WIB, format HH:MM.
WA_DAILY_SEND_TIME=08:30
